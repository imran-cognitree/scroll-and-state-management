#!/usr/bin/env sh
# Pre-commit: lint staged files, then run all unit/integration tests
# The --run flag is critical to prevent Vitest hanging in watch mode

cd frontend

echo "🔍 Running lint-staged..."
node_modules/.bin/lint-staged

if [ $? -ne 0 ]; then
  echo "❌ Linting failed. Commit blocked."
  exit 1
fi

echo "🧪 Running Vitest unit & integration tests..."
node_modules/.bin/vitest run

if [ $? -ne 0 ]; then
  echo "❌ Tests failed. Commit blocked."
  exit 1
fi

echo "✅ All checks passed. Proceeding with commit."
